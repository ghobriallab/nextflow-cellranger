/*
========================================================================================
    Nextflow Configuration File
========================================================================================
*/

// Global default params
params {
    // Input/Output options
    outdir                  = './results'
    samplesheet             = null

    // Pipeline options
    data_type               = 'GEX'  // 'GEX', 'FLEX', 'MULTIOME', or 'SOUPORCELL'
    reference               = null
    vdj_reference           = null   // VDJ reference for immune profiling
    probe_set               = null
    arc_reference           = null   // Pre-built cellranger-arc reference (e.g. refdata-cellranger-arc-GRCh38-2024-A), for MULTIOME

    // mkref options (provide fasta + gtf to build a reference on-the-fly)
    fasta                   = null   // Genome FASTA for cellranger mkref
    gtf                     = null   // GTF annotation for cellranger mkref
    genome_name             = 'custom_genome'  // Output directory name for mkref

    // Cell Ranger specific options
    cellranger_args         = ''
    expected_cells          = null
    force_cells             = null
    include_introns         = true  // for cellranger counts
    create_bam              = true // for cellranger counts
    // Override chemistry auto-detection when it fails (e.g. SC5P-PE-v3, SC3Pv3)
    chemistry               = null  // default: auto-detect

    // SoupOrCell options
    run_souporcell          = false
    souporcell_fasta        = null  // Reference genome FASTA file
    souporcell_clusters     = 2     // Number of expected clusters/genotypes (default for all samples)
    souporcell_clusters_file = null // CSV file with sample_id and sample_count columns for per-sample cluster counts

    // GCP compute options
    use_spot                = false   // Set to false to use on-demand instances

    // Publishing options
    publish_dir_mode        = 'copy'

    // Module-specific config
    config_profile_name        = null
    config_profile_description = null

    // Max resource options
    max_memory              = '128.GB'
    max_cpus                = 16
    max_time                = '240.h'

    // Container options
    cellranger_container     = 'us-docker.pkg.dev/ghobrial-pipelines/cellranger/cellranger:8.0.1'
    cellranger_arc_container = 'us-docker.pkg.dev/ghobrial-pipelines/cellranger/cellranger-arc:2.2.0'
}

// Process settings
process {
    container = params.cellranger_container

    errorStrategy = { task.exitStatus in [1,127] ? 'finish' : task.exitStatus in [143,137,104,134,139,14,125,50001,5005] ? 'retry' : 'ignore' }
    maxRetries = 5

    // disk = [request: '750 GB', type: 'local-ssd']
    // machineType = 'c3-*,n2-*,c3d-*,n2d-*'
}

// Load module configurations (after process defaults so params are resolved)
includeConfig 'conf/modules.config'

// Execution profiles
profiles {

    local {
        params.config_profile_name = 'Local'
        params.config_profile_description = 'Local execution profile for testing'

        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }

        process {
            executor = 'local'
            cpus   = 4
            memory = { 16.GB * task.attempt }
            time   = { 4.h * task.attempt }
        }
    }

    gcp {
        params.config_profile_name = 'Google Cloud'
        params.config_profile_description = 'Google Cloud Platform execution profile'

        workDir = 'gs://ghobrial-pipelines/scratch'

        process {
            executor = 'google-batch'
            disk = [request: 1500.GB, type: 'pd-balanced']
            stageInMode = 'copy'
            stageOutMode = 'copy'
            machineType = 'n2-*,c2-*,m3-*'
        }

        google {
            project = 'ghobrial-pipelines'
            location = 'us-east1'
            batch.spot = params.use_spot
            batch.bootDiskSize = 50.GB
        }
    }

    test {
        params.config_profile_name = 'Test'
        params.config_profile_description = 'Minimal test configuration'

        docker {
            enabled = true
        }

        process {
            cpus   = 2
            memory = 4.GB
            time   = 1.h

            withName: 'CELLRANGER_ARC_COUNT' {
                cpus   = 8
                memory = { 16.GB * task.attempt }
                time   = { 2.h * task.attempt }
            }
        }
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Execution reports
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

// Manifest
manifest {
    name            = 'scRNAseq-10x-pipeline'
    author          = 'Your Name'
    homePage        = ''
    description     = 'Nextflow pipeline for processing 10X single-cell RNA-seq data'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.0.0'
    version         = '1.0.0'
}

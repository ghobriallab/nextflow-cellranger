/*
========================================================================================
    Parameters Configuration File
========================================================================================
    This file contains default parameters that can be overridden at runtime.

    Usage:
    nextflow run main.nf -c conf/params.config --samplesheet samples.csv --reference /path/to/ref

    Or create your own params file and override:
    nextflow run main.nf -c conf/my_params.config
========================================================================================
*/

params {
    // ================================
    // Input/Output
    // ================================
    input_dir               = null
    outdir                  = './results'
    samplesheet             = null

    // ================================
    // Pipeline Options
    // ================================
    // Data type: 'GEX' for standard gene expression, 'FLEX' for multiplexed FLEX
    data_type               = 'GEX'

    // Path to Cell Ranger reference transcriptome
    // Download from 10X Genomics: https://www.10xgenomics.com/support/software/cell-ranger/downloads
    // Example: refdata-gex-GRCh38-2024-A
    reference               = null

    // Path to probe set CSV file (REQUIRED for FLEX data only)
    // Download from 10X Genomics: https://www.10xgenomics.com/support/software/cell-ranger/downloads
    // Example: Probe_Set_v1.0_GRCh38-2020-A.csv
    probe_set               = null

    // ================================
    // Cell Ranger Specific Options
    // ================================
    // Additional arguments to pass to cellranger count/multi
    cellranger_args         = ''

    // Expected number of cells (optional, cellranger will auto-detect if not set)
    expected_cells          = null

    // Force cells (optional, override auto cell detection)
    force_cells             = null

    // Include introns in gene expression counting (true/false)
    include_introns         = false

    // ================================
    // Resource Limits
    // ================================
    max_memory              = '128.GB'
    max_cpus                = 16
    max_time                = '240.h'

    // ================================
    // Publishing Options
    // ================================
    publish_dir_mode        = 'copy'  // 'copy', 'symlink', 'link'
}

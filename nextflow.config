/*
========================================================================================
    Nextflow Configuration File
========================================================================================
*/

// Global default params
params {
    // Input/Output options
    outdir                  = './results'
    samplesheet             = null

    // Pipeline options
    data_type               = 'GEX'  // 'GEX', 'FLEX', or 'SOUPORCELL'
    reference               = null
    vdj_reference           = null   // VDJ reference for immune profiling
    probe_set               = null
    
    // Cell Ranger specific options
    cellranger_args         = ''
    expected_cells          = null
    force_cells             = null
    include_introns         = true  // for cellranger counts
    create_bam              = true // for cellranger counts
    
    // SoupOrCell options
    run_souporcell          = false
    souporcell_fasta        = null  // Reference genome FASTA file
    souporcell_clusters     = 2     // Number of expected clusters/genotypes (default for all samples)
    souporcell_clusters_file = null // CSV file with sample_id and sample_count columns for per-sample cluster counts
    
    // Publishing options
    publish_dir_mode        = 'copy'

    // Module-specific config
    config_profile_name        = null
    config_profile_description = null

    // Max resource options
    max_memory              = '128.GB'
    max_cpus                = 16
    max_time                = '240.h'

    // Container options
    // Update this to use your custom Cell Ranger Docker image
    // Example for GCR: 'gcr.io/your-project/cellranger:10.0.0'
    // Example for Artifact Registry: 'us-docker.pkg.dev/your-project/cellranger/cellranger:10.0.0'
    cellranger_container    = 'us-docker.pkg.dev/ghobrial-pipelines/cellranger/cellranger:8.0.1'


}

// Load module configurations
includeConfig 'conf/modules.config'

// Process settings
process {
    // Default container - uses custom Cell Ranger image from params
    container = params.cellranger_container

    // Error strategy
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'ignore' }
    maxRetries = 2
}

// Execution profiles
profiles {

    // Local execution profile (for testing)
    local {
        params.config_profile_name = 'Local'
        params.config_profile_description = 'Local execution profile for testing'

        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }

        process {
            executor = 'local'
            cpus = { check_max( 4 , 'cpus' ) }
            memory = { check_max( 16.GB * task.attempt, 'memory' ) }
            time = { check_max( 4.h * task.attempt, 'time' ) }
        }
    }

    // Google Cloud Platform profile
    gcp {
        params.config_profile_name = 'Google Cloud'
        params.config_profile_description = 'Google Cloud Platform execution profile'
        
        workDir = 'gs://ghobrial-pipelines/scratch'

        process {
            executor = 'google-batch'
            disk = '500 GB'
        }

        google {
            project = 'ghobrial-pipelines'  // Set in params file or command line
            location = 'us-east1'
            batch.spot = false
            batch.bootDiskSize = '50 GB'
        }
    }

    // Test profile (minimal resources)
    test {
        params.config_profile_name = 'Test'
        params.config_profile_description = 'Minimal test configuration'

        docker {
            enabled = true
        }

        process {
            cpus = 2
            memory = 4.GB
            time = 1.h
        }
    }
}

// Resource labels
process {
    withLabel: process_low {
        cpus = { check_max( 2, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time = { check_max( 4.h * task.attempt, 'time' ) }
    }

    withLabel: process_medium {
        cpus = { check_max( 6, 'cpus' ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        time = { check_max( 8.h * task.attempt, 'time' ) }
    }

    withLabel: process_high {
        cpus = { check_max( 12 , 'cpus' ) }
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        time = { check_max( 16.h * task.attempt, 'time' ) }
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

// Execution reports
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}

// Manifest
manifest {
    name            = 'scRNAseq-10x-pipeline'
    author          = 'Your Name'
    homePage        = ''
    description     = 'Nextflow pipeline for processing 10X single-cell RNA-seq data'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}

// Function to ensure that resource requirements don't go beyond a maximum limit
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}

/*
========================================================================================
    Module-specific Configuration
========================================================================================
    This file contains default parameters for each process/module.
    These can be overridden in your params file or at runtime.
========================================================================================
*/

process {

    // ================================
    // CELLRANGER_MKREF (build reference)
    // ================================
    withName: 'CELLRANGER_MKREF' {
        ext.args = ''
        cpus   = { check_max( 16, 'cpus' ) }
        memory = { check_max( 64.GB, 'memory' ) }
        time   = { check_max( 12.h * task.attempt, 'time' ) }
    }

    // ================================
    // CELLRANGER_COUNT (GEX data)
    // ================================
    withName: 'CELLRANGER_COUNT' {
        ext.args = [
            params.expected_cells ? "--expect-cells=${params.expected_cells}" : '',
            params.force_cells ? "--force-cells=${params.force_cells}" : '',
            params.include_introns ? "--include-introns=true" : "--include-introns=false",
            params.create_bam ? "--create-bam=true" : "--create-bam=false",
            params.cellranger_args ?: ''
        ].join(' ').trim()
        // Resource configuration
        // stageOutMode 'copy'
        cpus   = { check_max( 16, 'cpus' ) }
        memory = { check_max( 92.GB, 'memory' ) }
        time   = { check_max( 24.h * task.attempt, 'time' ) }

        
    }

    // ================================
    // CELLRANGER_MULTI (FLEX data)
    // ================================
    withName: 'CELLRANGER_MULTI' {
        ext.args = [
            params.cellranger_args ?: ''
        ].join(' ').trim()
        // Resource configuration (FLEX/multiplexed samples typically need more resources)
        cpus   = { check_max( 16, 'cpus' ) }
        memory = { check_max( 92.GB, 'memory' ) }
        time   = { check_max( 48.h * task.attempt, 'time' ) }

    
    }

    // ================================
    // CELLRANGER_VDJ (V(D)J Immune Profiling)
    // ================================
    withName: 'CELLRANGER_VDJ' {
        ext.args = [
            params.cellranger_args ?: ''
        ].join(' ').trim()
        // Resource configuration
        cpus   = { check_max( 16 , 'cpus' ) }
        memory = { check_max( 64.GB , 'memory' ) }
        time   = { check_max( 9.h , 'time' ) }

    }

    // ================================
    // SOUPORCELL (Demultiplexing)
    // ================================
    withName: 'SOUPORCELL' {
        ext.args = ''
        stageInMode = 'copy'
        // Resource configuration
        cpus   = { check_max( 8, 'cpus' ) }
        memory = { check_max( 32.GB, 'memory' ) }
        time   = { check_max( 12.h * task.attempt, 'time' ) }
        disk = '1000 GB'
    }
}
